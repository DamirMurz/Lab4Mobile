<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragmets.Main">

    <TextView
        android:id="@+id/CityNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/M_merge"
        android:layout_marginEnd="@dimen/M_merge"
        android:gravity="center"
        android:text="@string/welcome_title"
        android:textSize="@dimen/text_LL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/cityPic"
        android:layout_width="0dp"
        android:layout_height="@dimen/landImage"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/M_merge"
        android:layout_marginEnd="@dimen/M_merge"
        android:src="@drawable/city"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CityNameText" />

    <TextView
        android:id="@+id/cityDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/M_merge"
        android:layout_marginEnd="@dimen/M_merge"
        android:layout_marginBottom="@dimen/M_merge"
        android:text="@string/city_description"
        android:textSize="@dimen/text_L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cityPic"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>