<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragmets.AboutFragment">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/S_merge"
        android:layout_marginEnd="@dimen/M_merge"
        android:layout_marginBottom="@dimen/M_merge"
        android:text="@string/app_version"
        android:textSize="@dimen/text_SS"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/M_merge"
        android:layout_marginEnd="@dimen/M_merge"
        android:text="@string/developer_info"
        android:textSize="@dimen/text_SS"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="@dimen/textSizeLand"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/M_merge"
        android:layout_marginBottom="@dimen/M_merge"
        android:text="@string/about_description"
        android:textSize="@dimen/M_merge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/M_merge"
        android:layout_marginTop="@dimen/S_merge"
        android:layout_marginEnd="@dimen/M_merge"
        android:text="@string/about_title"
        android:textSize="@dimen/text_LL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>